{
  "id": "insert-booking",
  "entry": "insertBooking",
  "starter": "function insertBooking(busy: number[][], booking: number[]): number[][] {\n  // busy is sorted and non-overlapping, half-open [start, end).\n  // Return the busy blocks after adding booking. Touching blocks stay separate.\n  return busy;\n}\n\nconsole.log(insertBooking([[1, 3], [5, 7], [8, 10], [12, 15]], [6, 9]));\n",
  "solution": "function insertBooking(busy: number[][], booking: number[]): number[][] {\n  const out: number[][] = [];\n  let [start, end] = booking;\n  let i = 0;\n  while (i < busy.length && busy[i][1] <= start) out.push(busy[i++]);\n  while (i < busy.length && busy[i][0] < end) {\n    start = Math.min(start, busy[i][0]);\n    end = Math.max(end, busy[i][1]);\n    i++;\n  }\n  out.push([start, end]);\n  while (i < busy.length) out.push(busy[i++]);\n  return out;\n}\n",

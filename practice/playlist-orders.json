  "hints": [
    "Fill the queue one slot at a time. What are your choices for the first slot, and what changes for the second?",
    "This is backtracking: choose, recurse, un-choose.",
    "Keep a used[] flag per track; at each depth loop over every unused track, mark it, push it, recurse, then pop it and unmark it. Copy the path when it is full."
  ],
  "rubric": {
    "signals": [
      "States there are n! orders and the output alone is O(n · n!)",
      "Uses choose / recurse / un-choose with a used flag or swaps",
      "Copies the path at the leaf instead of pushing the shared array",
      "Handles the empty input as one empty ordering, or asks about it"
    ],
    "followups": [
      "The queue has repeated tracks. List distinct orders only.",
      "Return only the k-th order without listing all of them.",
      "How large can n be before this is unreasonable?"
    ]

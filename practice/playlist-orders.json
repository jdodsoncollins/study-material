{
  "id": "playlist-orders",
  "entry": "allOrders",
  "starter": "function allOrders(tracks: string[]): string[][] {\n  // Every ordering of the distinct tracks. Any order of orderings is fine.\n  return [];\n}\n\nconsole.log(allOrders([\"lofi\", \"jazz\", \"punk\"]));\n",
  "solution": "function allOrders(tracks: string[]): string[][] {\n  const out: string[][] = [];\n  const path: string[] = [];\n  const used = tracks.map(() => false);\n  const walk = () => {\n    if (path.length === tracks.length) { out.push([...path]); return; }\n    for (let i = 0; i < tracks.length; i++) {\n      if (used[i]) continue;\n      used[i] = true;\n      path.push(tracks[i]);\n      walk();\n      path.pop();\n      used[i] = false;\n    }\n  };\n  walk();\n  return out;\n}\n",
  "compare": "unordered",

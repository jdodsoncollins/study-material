{
  "id": "support-flow-depth",
  "entry": "maxDepthFrom",
  "starter": "type TreeNode = { v: number; L: TreeNode | null; R: TreeNode | null };\n// Level-order array, null for a missing child.\nfunction buildTree(values: (number | null)[]): TreeNode | null {\n  if (!values.length || values[0] == null) return null;\n  const root: TreeNode = { v: values[0], L: null, R: null };\n  const q = [root];\n  let i = 1;\n  while (q.length && i < values.length) {\n    const cur = q.shift()!;\n    const l = values[i++];\n    if (l != null) { cur.L = { v: l, L: null, R: null }; q.push(cur.L); }\n    const r = values[i++];\n    if (r != null) { cur.R = { v: r, L: null, R: null }; q.push(cur.R); }\n  }\n  return root;\n}\n\nfunction maxDepth(root: TreeNode | null): number {\n  // Count the nodes on the longest root-to-leaf path. Empty tree: 0.\n  return 0;\n}\n\n// The tests pass the tree as a level-order array.\nfunction maxDepthFrom(values: (number | null)[]): number {\n  return maxDepth(buildTree(values));\n}\n\nconsole.log(maxDepthFrom([1, 2, 3, null, 4, 5, 6, null, null, 7]));\n",
  "solution": "type TreeNode = { v: number; L: TreeNode | null; R: TreeNode | null };\n// Level-order array, null for a missing child.\nfunction buildTree(values: (number | null)[]): TreeNode | null {\n  if (!values.length || values[0] == null) return null;\n  const root: TreeNode = { v: values[0], L: null, R: null };\n  const q = [root];\n  let i = 1;\n  while (q.length && i < values.length) {\n    const cur = q.shift()!;\n    const l = values[i++];\n    if (l != null) { cur.L = { v: l, L: null, R: null }; q.push(cur.L); }\n    const r = values[i++];\n    if (r != null) { cur.R = { v: r, L: null, R: null }; q.push(cur.R); }\n  }\n  return root;\n}\n\nfunction maxDepth(root: TreeNode | null): number {\n  let layer = root ? [root] : [];\n  let depth = 0;\n  while (layer.length) {\n    depth++;\n    const next: TreeNode[] = [];\n    for (const n of layer) {\n      if (n.L) next.push(n.L);\n      if (n.R) next.push(n.R);\n    }\n    layer = next;\n  }\n  return depth;\n}\n\nfunction maxDepthFrom(values: (number | null)[]): number {\n  return maxDepth(buildTree(values));\n}\n",
  "compare": "exact",
